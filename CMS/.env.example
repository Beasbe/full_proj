APP_NAME="Laravel CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Разрешённые Origin для CORS (через запятую).
# Для продакшена перечислите домены фронтенда.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

FILESYSTEM_DISK=public
SESSION_DRIVER=file
SESSION_LIFETIME=120

QUEUE_CONNECTION=sync

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_dev
DB_USERNAME=laravel
DB_PASSWORD=secret
