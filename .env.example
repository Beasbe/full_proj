# ============================================================
#  Параметры окружения для docker-compose.
#  Скопируйте в `.env` и задайте свои значения.
#  Файл `.env` не коммитится — в репозитории только `.env.example`.
# ============================================================

# --- MariaDB (используется сервисом db) ---
# Значения по умолчанию подходят ТОЛЬКО для локальной разработки.
# Для любых реальных стендов задайте собственные пароли.
MYSQL_DATABASE=laravel_dev
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=laravel
MYSQL_PASSWORD=secret

# --- URL бэкенда, вшиваемый во фронтенд при сборке образа ---
NEXT_PUBLIC_API_URL=http://localhost:8080
